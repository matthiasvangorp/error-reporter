{
    "name": "matthiasvangorp/error-reporter",
    "description": "Client library that ships exceptions and logs from a Laravel app to a self-hosted Error Dashboard collector.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "error-reporting",
        "monitoring",
        "exceptions",
        "logs"
    ],
    "authors": [
        {
            "name": "Matthias Van Gorp",
            "email": "matthiasvangorp@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "MatthiasVanGorp\\ErrorReporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MatthiasVanGorp\\ErrorReporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MatthiasVanGorp\\ErrorReporter\\ErrorReporterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
